# Copy to .env. Never commit the real file.
ENV=dev
DATABASE_URL=postgresql+psycopg://auth:auth@localhost:5432/auth

# Entra app registration (single tenant)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
REDIRECT_URI=http://localhost:57005/auth/callback

# Comma-separated. Post-login redirect targets; anything else is rejected.
POST_LOGIN_ALLOWLIST=/

# Drops the __Host- cookie prefix and the Secure flag. Refused when
# ENV=production. Only needed for plain-HTTP dev hosts that are not localhost.
DEV_INSECURE_COOKIES=false
